{
  "name": "music-master-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Refactored AI music creation platform (mock backend)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . 2>/dev/null || echo 'ESLint not configured - run: npm i -D eslint @typescript-eslint/parser @typescript-eslint/eslint-plugin eslint-plugin-react-hooks'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
